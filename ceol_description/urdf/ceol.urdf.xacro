<?xml version='1.0' encoding='utf-8'?>
<robot name="ceol" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="prefix" default="ceol_" />
  <xacro:arg name="mode" default="simulation" />
  <xacro:arg name="base_name" default="base" />
  <xacro:arg name="ros2_control_config_urdf_file" default="" />
  <xacro:arg name="controller_manager_config_yaml_file" default="" />
  <xacro:arg name="ros_prefix" default="/ceol/" />

  <xacro:include filename="$(find ceol_description)/urdf/ceol.xacro" />
  <xacro:ceol mode="$(arg mode)" prefix="$(arg prefix)" />

  <xacro:if value="${'gazebo' in '$(arg mode)'}">
    <xacro:include 
      filename="$(find romea_mobile_base_description)/urdf/gazebo_ros2_control.xacro" />
    <xacro:gazebo_ros2_control
      mode="$(arg mode)"
      base_name="$(arg base_name)"
      ros_prefix="$(arg ros_prefix)"
      controller_manager_config_yaml_file="$(arg controller_manager_config_yaml_file)" />
  </xacro:if>


</robot>